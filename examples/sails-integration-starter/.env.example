# Real Sails node base URL. NEXT_PUBLIC_ prefix so Next.js inlines it
# into the browser bundle (this starter's SailsClient runs client-side —
# see src/sails-integration/client.ts). SAILS_BASE_URL (no prefix) is
# the equivalent for the two standalone examples/*.ts scripts, which run
# in plain Node, not a browser.
NEXT_PUBLIC_SAILS_BASE_URL=http://localhost:3000
SAILS_BASE_URL=http://localhost:3000
