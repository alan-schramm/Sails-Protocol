  "cards": [
    { "dot": "cyan", "title": "Destination Authority ≠ Settlement Key", "items": [
      "Destination Authority is the beneficiary's own authority over where their entitlement is delivered (INV-01)",
      "Execution Authority / Settlement Key is only the capability to construct, sign, and broadcast — a separate axis"
    ] },
    { "dot": "rose", "title": "Authority ≠ Execution", "items": [
      "During recovery, execution reads the Outcome's own historically-bound destination — never whatever is currently registered",
      "Providers may not invent discretionary authority or redefine an authorized Outcome's meaning — the same rule covers a manually-triggered dispatch: initiating a call is not economic authority"
    ] },
    { "dot": "emerald", "title": "Report ≠ Truth", "items": [
      "An execution report is an Assertion, never world truth — Core may find correspondence, never certify the external world behaved as claimed"
    ] }
