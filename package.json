{
  "name": "satsails-p2p-protocol",
  "version": "0.1.1",
  "description": "Non-Custodial Multi-Asset P2P Marketplace Protocol",
  "main": "dist/src/main.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/alan-schramm/Sails-Protocol.git"
  },
  "keywords": [
    "sails",
    "p2p",
    "bitcoin",
    "escrow",
    "non-custodial",
    "sdk"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "contracts"
  ],
  "scripts": {
    "build": "npm run build -w @satsails/p2p-schemas && npm run build -w @satsails/p2p-trading-sdk && tsc",
    "start": "node dist/src/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "prepare": "husky install",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "db:local:start": "node scripts/local-postgres.js start",
    "db:local:stop": "node scripts/local-postgres.js stop",
    "redis:local:start": "node scripts/local-redis.js start",
    "redis:local:stop": "node scripts/local-redis.js stop",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:completeness-check": "npx prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:seed": "ts-node src/test/seeds/seed.ts",
    "db:studio": "npx prisma studio",
    "demo:pix-to-usdt": "ts-node --transpile-only examples/demo/pix-to-usdt-flow.ts",
    "demo:qvac": "ts-node --transpile-only examples/demo/demo-satsails-qvac.ts",
    "demo:multisig": "ts-node --transpile-only examples/demo/multisig-testnet-flow.ts",
    "test": "jest --runInBand",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "dev:ui": "npm run dev -w @sails/ui",
    "build:ui": "npm run build -w @sails/ui",
    "loadtest:intent": "artillery run load-tests/artillery/intent-api.yml",
    "loadtest:ws:prep": "node load-tests/artillery/pregenerate-users.js 50",
    "loadtest:ws": "artillery run load-tests/artillery/chat-ws.yml",
    "loadtest:sdk": "ts-node --transpile-only scripts/sdk-pressure-test.ts"
  },
  "dependencies": {
    "@arkade-os/sdk": "^0.4.62",
    "@aws-sdk/client-kms": "^3.1111.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@qvac/sdk": "^0.17.1",
    "@satsails/p2p-schemas": "^0.1.0",
    "@satsails/p2p-trading-sdk": "^0.1.0",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.15",
    "@types/pg": "^8.20.0",
    "b4a": "^1.8.1",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.1",
    "dotenv": "^17.4.2",
    "ecpair": "^3.0.1",
    "fastify": "^5.12.0",
    "fastify-plugin": "^6.0.0",
    "hyperdht": "^6.33.1",
    "hyperswarm": "^4.17.0",
    "ioredis": "^6.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sodium-native": "^5.1.0",
    "tiny-secp256k1": "^2.2.4",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/sodium-native": "^2.3.9",
    "@types/ws": "^8.18.1",
    "artillery": "^2.0.33",
    "embedded-postgres": "^18.4.0-beta.17",
    "husky": "^9.0.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "redis-memory-server": "^0.17.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "find-my-way": "^9.7.0",
    "brace-expansion": "^5.0.8",
    "tar": "^7.5.22",
    "valibot": "^1.4.2",
    "uuid": "^11.1.1",
    "react-router": "8.3.0"
  }
}
